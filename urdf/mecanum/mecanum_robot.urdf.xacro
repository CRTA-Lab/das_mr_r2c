<?xml version="1.0"?>

<robot name="mecanum_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find das_mr_r2c)/urdf/common.xacro"/>
  <xacro:include filename="$(find das_mr_r2c)/urdf/mecanum/mecanum.ros2_control.xacro"/>

  <xacro:property name="base_length"    value="0.40"/>
  <xacro:property name="base_width"     value="0.30"/>
  <xacro:property name="base_height"    value="0.10"/>
  <xacro:property name="wheel_radius"   value="0.08"/>
  <xacro:property name="wheel_width"    value="0.04"/>
  <xacro:property name="wheelbase"      value="0.30"/>
  <xacro:property name="wheel_track"    value="0.36"/>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
    <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="front_marker_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
      <geometry><cylinder radius="0.02" length="0.12"/></geometry>
      <material name="orange"/>
    </visual>
  </link>
  <joint name="front_marker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_marker_link"/>
    <origin xyz="${base_length/2 - 0.06} 0 ${base_height/2 + 0.02}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="mecanum_wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <visual>
        <origin xyz="${wheel_radius/2} 0 0" rpy="0 0 0"/>
        <geometry><box size="${wheel_radius} ${wheel_width + 0.002} 0.015"/></geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect * wheelbase / 2} ${y_reflect * wheel_track / 2} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:mecanum_wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:mecanum_wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:mecanum_wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <xacro:mecanum_ros2_control name="MecanumMockSystem"/>

</robot>
